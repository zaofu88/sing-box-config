{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "ntp": {
    "enabled": true,
    "server": "time.apple.com",
    "server_port": 123,
    "interval": "30m",
    "detour": "Direct-Out"
  },
  "dns": {
    "servers": [
      {
        "tag": "hosts",
        "type": "hosts",
        "predefined": {
          "dns.alidns.com": [
            "223.5.5.5",
            "223.6.6.6",
            "2400:3200::1",
            "2400:3200:baba::1"
          ],
          "dns.google": [
            "8.8.8.8",
            "8.8.4.4",
            "2001:4860:4860::8888",
            "2001:4860:4860::8844"
          ]
        }
      },
      {
        "tag": "dns_local",
        "type": "local"
      },
      {
        "tag": "dns_direct",
        "type": "udp",
        "server": "223.5.5.5",
        "server_port": 53
      },
      {
        "tag": "dns_proxy",
        "type": "https",
        "server": "dns.google",
        "domain_resolver": "hosts",
        "detour": "GLOBAL"
      },
      {
        "tag": "dns_fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "preferred_by": [
          "hosts"
        ],
        "action": "route",
        "server": "hosts"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "server": "dns_direct"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "server": "dns_proxy"
      },
      {
        "rule_set": [
          "private-site"
        ],
        "action": "route",
        "server": "dns_local"
      },
      {
        "rule_set": [
          "ai",
          "youtube",
          "google-site",
          "telegram-site",
          "github",
          "microsoft",
          "netflix-site",
          "disney",
          "amazon",
          "bahamut",
          "hbo",
          "hulu",
          "twitter",
          "tiktok",
          "spotify",
          "facebook-site",
          "instagram",
          "emby",
          "apple",
          "geolocation-!cn",
          "xunlei"
        ],
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "route",
        "server": "dns_fakeip"
      },
      {
        "rule_set": [
          "cn"
        ],
        "action": "route",
        "server": "dns_direct"
      },
      {
        "action": "evaluate",
        "server": "dns_proxy",
        "client_subnet": "211.136.192.0/24"
      },
      {
        "match_response": true,
        "rule_set": [
          "private-ip"
        ],
        "action": "route",
        "server": "dns_local"
      },
      {
        "match_response": true,
        "rule_set": [
          "cnip"
        ],
        "action": "route",
        "server": "dns_direct"
      },
      {
        "action": "respond"
      }
    ],
    "final": "dns_proxy",
    "strategy": "prefer_ipv4",
    "optimistic": true,
    "reverse_mapping": true
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed",
      "listen": "127.0.0.1",
      "listen_port": 7080
    },
    {
      "type": "tun",
      "tag": "tun",
      "address": [
        "172.18.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 1500,
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 7080
        }
      },
      "auto_route": true,
      "strict_route": true,
      "route_exclude_address": [
