{
    "log": {
        "disabled": false,
        "level": "warn",
        "output": "sing-box.log",
        "timestamp": true
    },
    "dns": {
        "servers": [
            {
                "tag": "hosts_fix",
                "type": "hosts",
                "predefined": {
                    "dns.alidns.com": [
                        "223.5.5.5",
                        "223.6.6.6"
                    ],
                    "doh.pub": [
                        "1.12.12.12",
                        "120.53.53.53"
                    ]
                }
            },
            {
                "tag": "ali-doh",
                "type": "https",
                "server": "dns.alidns.com",
                "domain_resolver": "hosts_fix"
            },
            {
                "tag": "ali-udp",
                "type": "udp",
                "server": "223.5.5.5"
            },
            {
                "tag": "tx-doh",
                "type": "https",
                "server": "doh.pub",
                "domain_resolver": "hosts_fix"
            },
            {
                "tag": "fakeip",
                "type": "fakeip",
                "inet4_range": "198.18.0.0/15",
                "inet6_range": "fc00::/18"
            },
            {
                "tag": "local",
                "type": "local"
            }
        ],
        "rules": [
            {
                "rule_set": [
                    "Reject"
                ],
                "action": "predefined",
                "rcode": "NXDOMAIN"
            },
            {
                "query_type": [
                    "HTTPS",
                    "SVCB"
                ],
                "action": "predefined",
                "rcode": "NOERROR"
            },
            {
                "domain_suffix": [
                    "lancache.steamcontent.com",
                    "10099.com.cn",
                    "msftconnecttest.com",
                    "msftncsi.com",
                    "local",
                    "lan",
                    "home",
                    "internal",
                    "corp",
                    "example.com",
                    "in-addr.arpa",
                    "ip6.arpa"
                ],
                "action": "route",
                "server": "local"
            },
            {
                "clash_mode": "Global",
                "action": "route",
                "server": "fakeip"
            },
            {
                "clash_mode": "Direct",
                "action": "route",
                "server": "local"
            },
            {
                "rule_set": [
                    "ChinaDomain"
                ],
                "action": "route",
                "server": "ali-doh"
            },
            {
                "query_type": [
                    "A",
                    "AAAA"
                ],
                "action": "route",
                "server": "fakeip",
                "rewrite_ttl": 1
            },
            {
                "action": "evaluate",
                "server": "ali-doh",
                "tag": "ali",
                "timeout": "5s"
            },
            {
                "action": "evaluate",
                "server": "tx-doh",
                "tag": "tencent",
                "timeout": "5s"
            },
            {
                "match_response": "ali",
                "response_rcode": "NOERROR",
                "action": "respond",
                "race": true
            },
            {
                "match_response": "tencent",
                "response_rcode": "NOERROR",
                "action": "respond",
                "race": true
            }
        ],
        "reverse_mapping": true,
        "strategy": "prefer_ipv4",
        "optimistic": true,
        "final": "ali-udp"
    },
    "inbounds": [
        {
            "type": "mixed",
            "tag": "mixed",
            "listen": "127.0.0.1",
            "listen_port": 7080
